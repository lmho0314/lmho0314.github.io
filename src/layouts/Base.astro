---
import '../styles/global.css';
import { NAV, SITE, u } from '../lib/site';

interface Props { title?: string; description?: string; }
const { title, description = SITE.tagline } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isCur = (href: string) => (href === '/' ? path === '/' || path === '' : path.startsWith(href));
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · ${SITE.name}` : SITE.name}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" />
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="site-h">
    <div class="wrap">
      <a class="brand" href={u('/')}>DART STUDY RESEARCH</a>
      <nav class="nav" aria-label="주 메뉴">
        {NAV.map((n) => <a href={u(n.href)} aria-current={isCur(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-f">
    <div class="wrap">
      <span>{SITE.name} · {SITE.author}의 개인 리서치 아카이브</span>
      <span>{SITE.disclaimer}</span>
    </div>
  </footer>
</body>
</html>
