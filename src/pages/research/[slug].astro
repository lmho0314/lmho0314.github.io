---
// 회차 노트 상세 (notes/*.md → sync_site.py → src/posts/sessions)
import Base from '../../layouts/Base.astro';
import { SESSIONS, VOL1, DATASETS, u } from '../../lib/site';
export function getStaticPaths() {
  return SESSIONS.map((s: any) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as any;
const idx = SESSIONS.findIndex((x: any) => x.slug === s.slug);
const prev = SESSIONS[idx - 1], next = SESSIONS[idx + 1];
const page = VOL1.pages[s.vol1Page - 1];
const outs = DATASETS.filter((d) => (s.outputs || []).includes(d.file));
const { Content } = s;
---
<Base title={s.title}>
  <div class="wrap">
    <nav class="small muted" aria-label="경로" style="padding-top:16px"><a href={u('/research')}>Research</a> / {s.session ? '회차 노트' : '복습 노트'}</nav>
    <section class="phead" style="padding-top:28px">
      <div class="eyebrow">{s.session ? `Session Note · ${String(s.session).padStart(2, '0')}` : 'Review · 01–05'} · 금융지주 Vol.1</div>
      <h1>{s.title}</h1>
      <p class="lead" style="font-size:15px;color:var(--muted)">{s.date} · {s.target}</p>
    </section>
    <div class="grid12 block" style="padding-top:28px">
      <article class="span8 prose"><Content /></article>
      <aside class="span4">
        <dl class="meta">
          <dt>날짜</dt><dd>{s.date}</dd>
          <dt>대상</dt><dd>{s.target}</dd>
          <dt>원본</dt><dd class="small">{s.source}</dd>
        </dl>
        {page && (
          <div style="margin-top:24px">
            <div class="small muted" style="margin-bottom:6px">리포트 Vol.1 · p.{s.vol1Page} — {page.label}</div>
            <a href={u(`/research/vol1?p=${s.vol1Page}`)}><img src={u(`/img/vol1/vol1_p${s.vol1Page}.jpg`)} alt={`${page.label} 쪽 미리보기`} style="width:100%;border:1px solid var(--hair);display:block" /></a>
            <div class="small" style="margin-top:6px">{page.title}</div>
          </div>
        )}
        {outs.length > 0 && (
          <div style="margin-top:24px">
            <h2 class="sec" style="font-size:14px">산출물</h2>
            {outs.map((d) => <p class="small" style="margin:6px 0"><a href={u(`/files/data/${d.file}`)} download>{d.file}</a><br /><span class="muted">{d.desc} · {d.rows}행</span></p>)}
          </div>
        )}
      </aside>
    </div>
    <nav class="grid12 block" aria-label="이전·다음" style="padding-top:40px">
      <div class="span4">{prev && <a href={u(`/research/${prev.slug}`)}><span class="small muted">← 이전</span><br />{prev.title}</a>}</div>
      <div class="span4"></div>
      <div class="span4" style="text-align:right">{next && <a href={u(`/research/${next.slug}`)}><span class="small muted">다음 →</span><br />{next.title}</a>}</div>
    </nav>
  </div>
</Base>
