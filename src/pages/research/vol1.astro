---
// 업종 리포트 상세 — 공시에서 PBR까지 (금융지주 Vol.1)
import Base from '../../layouts/Base.astro';
import { VOL1, COMPANIES, DATASETS, LOGS, SESSIONS, u } from '../../lib/site';

const W = 820, H = 400, L = 56, R = 800, T = 20, B = 360;
const x = (r: number) => L + ((r - 7) / 9) * (R - L);
const yP = (v: number) => T + ((1.1 - v) / 0.7) * (B - T);
const yE = (v: number) => T + ((12 - v) / 6) * (B - T);
const pts = (m: 'pbr' | 'per') => COMPANIES.map((c) => ({ ...c, cx: x(c.roe), cy: m === 'pbr' ? yP(c.pbr) : yE(c.per), v: m === 'pbr' ? c.pbr : c.per }));
const ticks = { pbr: [0.4, 0.6, 0.8, 1.0].map((v) => ({ y: yP(v), l: v.toFixed(1) })), per: [6, 8, 10, 12].map((v) => ({ y: yE(v), l: String(v) })) };
const xt = [8, 10, 12, 14, 16].map((r) => ({ x: x(r), l: r + '%' }));
const NOTE: Record<string, string> = {
  'iM금융지주': 'ROE 9.4%로 우리금융(8.9%)보다 잘 버는데 PBR은 0.46배로 더 싸다. 관계에서 벗어난 지점 = 저평가 후보. 6회차 회귀 잔차로 판정한다.',
  'KB금융': '같은 회사 PBR이 두 개다. 한투는 직전 결산 BPS 기준 1.07배, 이 리포트는 반기말 자본 기준 1.03배. 기준 시점을 밝혀야 한다.',
};
const data = COMPANIES.map((c) => ({ ...c, note: NOTE[c.name] || '2026.09.15 기준 스냅샷. PBR은 반기말 지배주주지분 기준.' }));
const sessions = SESSIONS.filter((s: any) => s.session > 0);
---
<Base title={VOL1.title} description={VOL1.sub}>
  <div class="wrap">
    <nav class="small muted" aria-label="경로" style="padding-top:16px"><a href={u('/research')}>Research</a> / 업종 리포트 / 금융지주</nav>

    <section class="phead grid12" style="padding-top:28px">
      <div class="span8">
        <div class="eyebrow">{VOL1.eyebrow}</div>
        <h1 style="font-size:40px">{VOL1.title}</h1>
        <p class="lead">{VOL1.sub}</p>
        <h2 class="acc">Summary</h2>
        <div class="prose" style="font-size:16px">
          <p><b style="color:var(--ink)">은행은 남의 돈으로 장사하는 회사다.</b> KB금융은 자기자본 1원으로 자산 13.8원을 굴린다. 자산의 대부분은 대출(505조), 부채의 대부분은 예금(486조)이다.</p>
          <p><b style="color:var(--ink)">얇은 마진 × 높은 레버리지 = 두 자릿수 ROE.</b> 자산 대비 수익(ROA)은 0.95%에 불과하지만, 레버리지 13.8배를 곱해 주주 기준 ROE 13.0%(2026 상반기 연환산, 공시 13.11%)를 만든다.</p>
          <p><b style="color:var(--ink)">시장은 ROE가 높은 금융지주에 더 높은 PBR을 준다.</b> 7개사 중 ROE 13% 안팎의 KB·JB는 PBR 1배 수준, ROE 7~9%대 지방 지주는 0.45배 안팎이다. 예외인 iM금융을 6회차에서 검증한다.</p>
        </div>
      </div>
      <aside class="span4" style="margin-top:28px">
        <dl class="meta">
          <dt>게시일</dt><dd>{VOL1.date}</dd>
          <dt>버전</dt><dd>{VOL1.version}</dd>
          <dt>분량</dt><dd>A4 7쪽 · 그림 6 · 표 7</dd>
          <dt>대상</dt><dd>금융지주 7개사 (KB금융 중심)</dd>
          <dt>기준 보고서</dt><dd>KB금융 2026 반기보고서 (20260814004200)</dd>
          <dt>데이터</dt><dd>DART · 한국투자증권 Open API</dd>
          <dt>작성</dt><dd>경제학과 학부생</dd>
        </dl>
        <div style="display:flex;flex-direction:column;gap:8px;margin-top:18px">
          <a class="btn solid" href={u('/files/vol1/vol1.pdf')}>PDF 내려받기 <span aria-hidden="true">↓</span></a>
          <a class="btn" href={u('/files/vol1/vol1.html')}>HTML 원본 <span aria-hidden="true">↗</span></a>
        </div>
        <h2 class="sec" style="font-size:14px;margin-top:28px">KB금융 주요 지표</h2>
        <table class="t small">
          <tbody>
            <tr><td>현재가 (09.23)</td><td class="num">174,100원</td></tr>
            <tr><td>시가총액</td><td class="num">61.8조</td></tr>
            <tr><td>BPS (직전 결산)</td><td class="num">164,669원</td></tr>
            <tr><td>PBR (반기말 자본)</td><td class="num">1.03배</td></tr>
            <tr><td>ROE (연환산)</td><td class="num">13.0%</td></tr>
            <tr><td>ROA · 레버리지</td><td class="num">0.95% · 13.8배</td></tr>
            <tr><td>NIM (국민은행)</td><td class="num">1.76%</td></tr>
          </tbody>
        </table>
        <p class="src">자료: DART 2026 반기보고서, 한국투자증권 Open API</p>
      </aside>
    </section>

    <section class="block" aria-labelledby="toc">
      <h2 class="sec" id="toc">회차별 요약</h2>
      <table class="t">
        <thead><tr><th style="width:90px">회차</th><th>헤드라인</th><th style="width:200px">핵심 그림·표</th><th class="num" style="width:70px">쪽</th></tr></thead>
        <tbody>
          {VOL1.pages.slice(1, 6).map((p, i) => (
            <tr><td>{p.label.replace('Session ', 'S')}</td><td><a href={u(`/research/${sessions[i]?.slug ?? ''}`)}>{p.title}</a></td><td class="small">{p.el}</td><td class="num"><a href="#viewer" data-goto={i + 2}>{i + 2}</a></td></tr>
          ))}
          <tr><td>부록</td><td>{VOL1.pages[6].title}</td><td class="small">{VOL1.pages[6].el}</td><td class="num"><a href="#viewer" data-goto="7">7</a></td></tr>
        </tbody>
      </table>
    </section>

    <section class="block" id="viewer" aria-labelledby="vw" data-viewer>
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap">
        <h2 class="sec" id="vw" style="border:0;margin:0">리포트 넘겨보기</h2>
        <div class="pager"><button type="button" data-prev aria-label="이전 쪽">←</button><span data-pno>1 / 7</span><button type="button" data-next aria-label="다음 쪽">→</button></div>
      </div>
      <div class="viewer" style="margin-top:14px">
        <figure><img class="pg" data-img src={u('/img/vol1/vol1_p1.jpg')} alt="1쪽 표지" width="900" height="1273" /></figure>
        <div class="plist" role="list" aria-label="쪽 목록">
          {VOL1.pages.map((p, i) => (
            <button type="button" role="listitem" data-p={i + 1} aria-current={i === 0 ? 'true' : 'false'}>
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              <img src={u(`/img/vol1/vol1_p${i + 1}.jpg`)} alt="" loading="lazy" />
              <span><span class="lb">{p.label}</span><span class="tt">{p.title}</span><span class="el">{p.el}</span></span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="f6" data-fig6>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
        <h2 class="sec" id="f6" style="border:0;margin:0">그림 6 다시 보기 — 금융지주 7개사 ROE와 <span data-mname>PBR</span></h2>
        <div class="seg" role="group" aria-label="세로축 지표"><button type="button" data-m="pbr" aria-pressed="true">PBR</button><button type="button" data-m="per" aria-pressed="false">PER</button></div>
      </div>
      <p class="small muted">점이나 오른쪽 기업명을 누르면 그 기업의 스냅샷이 열린다. PDF의 정적 그림 6을 웹에서 다시 그렸다.</p>
      <div class="chartwrap">
        <div>
          {(['pbr', 'per'] as const).map((m) => (
            <svg viewBox={`0 0 ${W} ${H + 30}`} role="img" aria-label={`ROE와 ${m.toUpperCase()} 산점도`} data-chart={m} style={`width:100%;height:auto;display:${m === 'pbr' ? 'block' : 'none'}`}>
              {ticks[m].map((t) => (<g><line x1={L} x2={R} y1={t.y} y2={t.y} stroke="#eef0f2" /><text x={L - 8} y={t.y + 4} text-anchor="end" font-size="12" fill="#979ca2">{t.l}</text></g>))}
              {xt.map((t) => (<g><line x1={t.x} x2={t.x} y1={T} y2={B} stroke="#eef0f2" /><text x={t.x} y={B + 20} text-anchor="middle" font-size="12" fill="#979ca2">{t.l}</text></g>))}
              <line x1={L} x2={R} y1={B} y2={B} stroke="#a3a8ae" /><line x1={L} x2={L} y1={T} y2={B} stroke="#a3a8ae" />
              <text x="0" y="12" font-size="12" fill="#7a7f86">{m.toUpperCase()} (배)</text>
              <text x={R} y={B + 40} text-anchor="end" font-size="12" fill="#7a7f86">ROE (2026 상반기 연환산)</text>
              {pts(m).map((p) => (
                <g data-pt={p.name} style="cursor:pointer" tabindex="0" role="button" aria-label={`${p.name} ROE ${p.roe}% ${m.toUpperCase()} ${p.v.toFixed(2)}`}>
                  <circle cx={p.cx} cy={p.cy} r="6" fill="#8a9097" />
                  <text x={p.short === 'JB' ? p.cx - 64 : p.cx + 11} y={p.short === 'JB' ? p.cy + 16 : p.cy - 8} font-size="13" fill="#5f646a">{p.short} {p.v.toFixed(2)}</text>
                </g>
              ))}
            </svg>
          ))}
          <p class="src">자료: DART 2026 반기보고서, 한국투자증권 Open API 시세(2026.09.15). PBR = 시가총액 ÷ 반기말 지배주주지분 · PER은 한투 제공값(직전 결산 EPS 기준)</p>
        </div>
        <div>
          <div class="colist" role="list" aria-label="기업 선택" style="border-top:1px solid var(--ink)">
            {COMPANIES.map((c) => <button type="button" role="listitem" data-c={c.name} aria-pressed="false"><span>{c.name}</span><span class="v" data-v={c.name}>ROE {c.roe.toFixed(1)}% · PBR {c.pbr.toFixed(2)}</span></button>)}
          </div>
          <dl class="meta" style="margin-top:18px" data-detail>
            <dt style="grid-column:1/-1;font-size:16px;font-weight:700;color:var(--ink)" data-f="name">iM금융지주</dt>
            <dt>현재가</dt><dd data-f="price"></dd>
            <dt>시가총액</dt><dd data-f="cap"></dd>
            <dt>PBR</dt><dd data-f="pbr"></dd>
            <dt>ROE</dt><dd data-f="roe"></dd>
            <dt>PER</dt><dd data-f="per"></dd>
            <dd style="grid-column:1/-1;font-size:13px;color:var(--muted);line-height:1.6" data-f="note"></dd>
          </dl>
        </div>
      </div>
      <script type="application/json" id="co-data" set:html={JSON.stringify(data)}></script>
    </section>

    <section class="block grid12">
      <div style="grid-column:span 6">
        <h2 class="sec">정정 기록</h2>
        <table class="t">
          <thead><tr><th>회차</th><th>당초</th><th>정정</th><th>원인</th></tr></thead>
          <tbody>
            <tr><td>02</td><td class="strike">충당금 −0.52조</td><td><b>−1.01조</b></td><td>3개월치를 누적으로 착오</td></tr>
            <tr><td>03</td><td class="strike">ROE 13.1%</td><td><b>13.0%</b></td><td>분자를 지배주주 순이익(3.88조)으로</td></tr>
          </tbody>
        </table>
        <p class="small muted">두 건 모두 개념은 그대로, 숫자만 수정. 데이터 함정 1·2의 실제 사례.</p>
      </div>
      <div style="grid-column:span 6">
        <h2 class="sec">산출물 · 데이터</h2>
        <table class="t">
          <tbody>
            {DATASETS.map((d) => <tr><td><a href={u(`/files/data/${d.file}`)} download>{d.file}</a><br /><span class="small muted">{d.desc}</span></td><td class="small num">{d.rows}행</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section class="block grid12">
      <h2 class="span3" style="margin:0;font-size:16px;color:var(--ink)">이 리포트를 만든 결정</h2>
      <div class="span9" style="border-top:1px solid var(--ink)">
        {LOGS.map((l: any) => <p style="margin:0;padding:12px 0;border-bottom:1px solid var(--hair)"><span class="small muted" style="margin-right:14px">{l.date}</span><a href={u(`/log/${l.slug}`)}>{l.title}</a></p>)}
      </div>
    </section>
  </div>
</Base>

<script>
  // 쪽 넘겨보기
  const vw = document.querySelector<HTMLElement>('[data-viewer]');
  if (vw) {
    const img = vw.querySelector<HTMLImageElement>('[data-img]')!;
    const btns = Array.from(vw.querySelectorAll<HTMLButtonElement>('[data-p]'));
    const pno = vw.querySelector('[data-pno]')!;
    let cur = 1;
    const go = (n: number) => {
      cur = ((n - 1 + 7) % 7) + 1;
      const b = btns[cur - 1];
      img.src = b.querySelector('img')!.getAttribute('src')!;
      img.alt = `${cur}쪽 ${b.querySelector('.lb')!.textContent}`;
      btns.forEach((x, i) => x.setAttribute('aria-current', String(i === cur - 1)));
      pno.textContent = `${cur} / 7`;
    };
    btns.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.p))));
    vw.querySelector('[data-prev]')!.addEventListener('click', () => go(cur - 1));
    vw.querySelector('[data-next]')!.addEventListener('click', () => go(cur + 1));
    document.querySelectorAll<HTMLElement>('[data-goto]').forEach((a) => a.addEventListener('click', () => go(Number(a.dataset.goto))));
    const p = Number(new URLSearchParams(location.search).get('p'));
    if (p >= 1 && p <= 7) { go(p); vw.scrollIntoView(); }
  }

  // 그림 6 인터랙티브
  const f6 = document.querySelector<HTMLElement>('[data-fig6]');
  if (f6) {
    const DATA = JSON.parse(document.getElementById('co-data')!.textContent || '[]');
    let metric = 'pbr', sel = 'iM금융지주';
    const render = () => {
      f6.querySelectorAll<SVGElement>('[data-chart]').forEach((s) => (s.style.display = s.dataset.chart === metric ? 'block' : 'none'));
      f6.querySelectorAll<HTMLElement>('[data-m]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.m === metric)));
      f6.querySelector('[data-mname]')!.textContent = metric.toUpperCase();
      f6.querySelectorAll<SVGGElement>('[data-pt]').forEach((g) => {
        const on = g.dataset.pt === sel;
        const c = g.querySelector('circle')!, t = g.querySelector('text')!;
        c.setAttribute('fill', on ? '#0f6f84' : '#8a9097'); c.setAttribute('r', on ? '8' : '6');
        t.setAttribute('fill', on ? '#141414' : '#5f646a'); t.setAttribute('font-weight', on ? '700' : '400');
      });
      f6.querySelectorAll<HTMLElement>('[data-c]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.c === sel)));
      DATA.forEach((d: any) => {
        const v = f6.querySelector(`[data-v="${d.name}"]`);
        if (v) v.textContent = `ROE ${d.roe.toFixed(1)}% · ${metric === 'pbr' ? 'PBR ' + d.pbr.toFixed(2) : 'PER ' + d.per.toFixed(2)}`;
      });
      const d = DATA.find((x: any) => x.name === sel);
      const set = (k: string, v: string) => (f6.querySelector(`[data-f="${k}"]`)!.textContent = v);
      set('name', d.name); set('price', d.price + '원'); set('cap', d.cap + '조'); set('pbr', d.pbr.toFixed(2) + '배');
      set('roe', d.roe.toFixed(1) + '%'); set('per', d.per.toFixed(2) + '배'); set('note', d.note);
    };
    f6.querySelectorAll<HTMLElement>('[data-m]').forEach((b) => b.addEventListener('click', () => { metric = b.dataset.m!; render(); }));
    f6.querySelectorAll<HTMLElement>('[data-c]').forEach((b) => b.addEventListener('click', () => { sel = b.dataset.c!; render(); }));
    f6.querySelectorAll<SVGGElement>('[data-pt]').forEach((g) => {
      g.addEventListener('click', () => { sel = g.dataset.pt!; render(); });
      g.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { sel = g.dataset.pt!; render(); } });
    });
    render();
  }
</script>
